# Supabase project URL and anon key (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only; used for Auth admin and Storage)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres through the Supabase transaction pooler (port 6543; server only). All business reads/writes use this.
DATABASE_URL=
# Postgres through the session pooler (port 5432; migrations and tests)
DATABASE_URL_SESSION=
# Nexconn App Key (public by design, returned by /api/config), App Secret (server only), area SG | NA | SA
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA=SG
# nexconn | mock. mock = in-process bus for local dev and tests; production refuses to start with it.
REALTIME_MODE=nexconn
# 1 = send DB:* cards as [[DB:Type]]{json} text if custom types do not reach web clients
NEXCONN_TEXT_ENVELOPE=0
# Unconfirmed Nexconn features: 0 or 1 each. Every one has a working fallback.
FEATURE_PREMESSAGE=0
FEATURE_COMMUNITY=0
FEATURE_SYSTEM_CHANNEL=0
FEATURE_CALLS=0
# AI (server only)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=google/gemini-3.5-flash-lite
AI_FALLBACK_MODELS=
# 32+ random characters each (server only)
SESSION_SECRET=
CRON_SECRET=
# Public base URL for share links and QR codes
APP_URL=http://localhost:3000
